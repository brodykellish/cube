# MIDI Controller Configuration
# Maps physical MIDI controller CC numbers to shader parameters

# Device name to connect to (or "auto" to use first available)
device_name: "Minilab3"

# MIDI CC mappings
# Each mapping connects a MIDI CC from your controller to a shader parameter
mappings:
  # Shader parameters (knobs 1-4)
  - midi_cc: 20
    target: param0
    min: 0
    max: 127

  - midi_cc: 21
    target: param1
    min: 0
    max: 127

  - midi_cc: 22
    target: param2
    min: 0
    max: 127

  - midi_cc: 23
    target: param3
    min: 0
    max: 127

  # Beat envelope controls (knobs 6-8)
  - midi_cc: 24      # Knob 6 -> Attack time
    target: param4
    min: 0
    max: 127

  - midi_cc: 25      # Knob 7 -> Hold time
    target: param5
    min: 0
    max: 127

  - midi_cc: 26      # Knob 8 -> Decay time (assuming CC 16)
    target: param6
    min: 0
    max: 127

  - midi_cc: 27      # Knob 8 -> Decay time (assuming CC 16)
    target: param7
    min: 0
    max: 127

# Notes:
# - Find your controller's CC numbers using a MIDI monitor tool
# - Common CC numbers:
#   - Faders: 70-79
#   - Knobs: 10-19, 70-79
#   - Buttons: 20-29, 40-49
# - Targets must be: param0, param1, param2, or param3
# - Multiple MIDI CCs can map to the same parameter (last value wins)
